# Configuración pública de Supabase para el panel /admin.
SUPABASE_URL=https://higdtttcndqzapkenets.supabase.co
# Opcional: si se deja vacío, se conserva la clave pública actual del proyecto.
SUPABASE_PUBLISHABLE_KEY=

# Solo servidor: necesaria para crear usuarios y cambiar roles desde /admin.
# Nunca debe enviarse al navegador ni incluirse en archivos públicos.
# Preferida: Secret API Key moderna (sb_secret_...) de Settings > API Keys.
SUPABASE_SECRET_KEY=
# Alternativa compatible: service_role JWT legacy. No es necesario configurar ambas.
SUPABASE_SERVICE_ROLE_KEY=

# Clave privada usada únicamente por el proxy existente de Gemini.
GEMINI_API_KEY=
