# Configuración pública de Supabase para el panel /admin.
SUPABASE_URL=https://higdtttcndqzapkenets.supabase.co
# Opcional: si se deja vacío, se conserva la clave pública actual del proyecto.
SUPABASE_PUBLISHABLE_KEY=

# Solo servidor: necesaria para crear usuarios y cambiar roles desde /admin.
# Nunca debe enviarse al navegador ni incluirse en archivos públicos.
# Preferida: Secret API Key moderna (sb_secret_...) de Settings > API Keys.
SUPABASE_SECRET_KEY=
# Alternativa compatible: service_role JWT legacy. No es necesario configurar ambas.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public read integration. Enable in a test environment first.
LNE_PUBLIC_BACKEND=
LNE_DUBLYOBASE_URL=https://dublyobase.yaperocallate.dpdns.org
LNE_DUBLYOBASE_PROJECT=la_norma_express
# Private server credential. Do not use the project MCP token here.
LNE_DUBLYOBASE_SERVICE_KEY=
# Activar después de verificar el acceso privado y los permisos en Coolify.
LNE_DUBLYOBASE_ADMIN_ENABLED=false
LNE_DUBLYOBASE_DATABASE_URL=
# Activar después de comprobar el envío de códigos en Dublyobase.
LNE_DUBLYOBASE_RECOVERY_ENABLED=false
LNE_DUBLYOBASE_PRIVATE_ACTIVATION=false
# Dirección real verificada del propietario. No usar alias de inicio de sesión.
LNE_DUBLYOBASE_VERIFIED_RECOVERY_EMAIL=

# Clave privada usada únicamente por el proxy existente de Gemini.
GEMINI_API_KEY=
